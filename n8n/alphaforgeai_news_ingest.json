      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "log-status",
              "name": "status",
              "value": "={{ $json.statusCode || $json.status || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "log-body",
              "name": "response_body",
              "value": "={{ JSON.stringify($json.body || $json) }}",
