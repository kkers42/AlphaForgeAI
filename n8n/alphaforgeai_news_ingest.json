    {
      "id": "node-dedup-filter",
      "name": "Dedup and Filter Recent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "jsCode": "// Deduplicate by URL, filter to last 12 hours\nconst twelveHoursAgo = new Date(Date.now() - 12 * 60 * 60 * 1000);\nconst seen = new Set();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const url = item.json.link || item.json.url || item.json.guid || '';\n  if (!url || seen.has(url)) continue;\n  const pubDate = item.json.pubDate || item.json.isoDate || item.json.date || '';\n  if (pubDate) {\n    const dt = new Date(pubDate);\n    if (isNaN(dt.getTime()) || dt < twelveHoursAgo) continue;\n  }\n  seen.add(url);\n  results.push({\n    json: {\n      title: item.json.title || '',\n      url: url,\n      description: item.json.contentSnippet || item.json.content || item.json.summary || item.json.description || '',\n      published_at: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),\n      source: item.json.creator || item.json.author || ''\n    }\n  });\n}\n\nreturn results;\n"
      }
    },
    {
      "id": "node-openai",
      "name": "OpenAI Enrich Article",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1040,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "3QlXsVVOjijxPwkU",
          "name": "OpenAi account"
        }
      },
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a crypto market analyst. Analyze this article and respond with ONLY valid JSON (no markdown, no explanation):\n{\n  \"relevance_score\": <0-10 integer, 10=highly relevant to crypto markets>,\n  \"summary\": \"<2-3 sentence factual summary, no financial advice>\",\n  \"category\": \"<one of: market, regulation, technology, defi, nft, exchange, macro, other>\",\n  \"assets\": [<list of ticker symbols mentioned, e.g. \"BTC\", \"ETH\", \"SOL\">],\n  \"sentiment\": \"<one of: bullish, bearish, neutral>\"\n}"
            },
            {
              "role": "user",
              "content": "Article title: {{ $json.title }}\nArticle content/description: {{ $json.description }}"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 400
        }
      }
    },
    {
      "id": "node-parse-openai",
      "name": "Parse OpenAI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  try {\n    const content = item.json.choices?.[0]?.message?.content || item.json.message?.content || '{}';\n    const cleaned = content.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\n    const analysis = JSON.parse(cleaned);\n    results.push({\n      json: {\n        title: item.json.title || '',\n        url: item.json.url || '',\n        source: item.json.source || '',\n        published_at: item.json.published_at || new Date().toISOString(),\n        relevance_score: analysis.relevance_score || 0,\n        summary: analysis.summary || '',\n        category: analysis.category || 'other',\n        assets: analysis.assets || [],\n        sentiment: analysis.sentiment || 'neutral'\n      }\n    });\n  } catch (e) {\n    continue;\n  }\n}\nreturn results;\n"
      }
    },
    {
      "id": "node-filter",
      "name": "Filter Relevance >= 7",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-relevance",
              "leftValue": "={{ $json.relevance_score }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-aggregate",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(item => ({\n  title: item.json.title,\n  source: item.json.source,\n  url: item.json.url,\n  published_at: item.json.published_at,\n  summary: item.json.summary,\n  category: item.json.category,\n  assets: item.json.assets,\n  sentiment: item.json.sentiment\n}));\n\nreturn [{ json: { schema_version: 1, items: items } }];\n"
      }
    },
    {
      "id": "node-http-post",
      "name": "POST to AlphaForgeAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TWoqkRTdRS1N4AXa",
          "name": "AlphaForgeAI News Ingest Key"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://alphaforgeai.io/api/news/ingest",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "node-log",
