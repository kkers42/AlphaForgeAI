      "parameters": {
        "method": "POST",
        "url": "https://alphaforgeai.io/api/news/ingest",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "rawContentType": "application/json"
      }
